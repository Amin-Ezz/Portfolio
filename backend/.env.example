# Django Production Environment Configuration
# Copy this file to .env and adjust values for your server environment.

# Django Secret Key (Generate a strong random 50+ char string for production)
DJANGO_SECRET_KEY=production-secret-key-change-this-in-server-389f2j3f0923jf092jf

# Debug Mode: Set to False in production
DJANGO_DEBUG=False

# Allowed Hostnames (Comma-separated)
DJANGO_ALLOWED_HOSTS=aminez.ir,www.aminez.ir,127.0.0.1,localhost

# CSRF Trusted Origins (Required for Django 4/5 form submissions over HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=https://aminez.ir,https://www.aminez.ir,http://127.0.0.1:8000,http://localhost:3000

# CORS Allowed Origins
DJANGO_CORS_ALLOWED_ORIGINS=https://aminez.ir,https://www.aminez.ir,http://127.0.0.1:8000,http://localhost:3000

# Security: Redirect HTTP to HTTPS (Set to True if not handled by Nginx)
SECURE_SSL_REDIRECT=False
